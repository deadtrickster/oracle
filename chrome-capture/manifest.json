{
  "manifest_version": 3,
  "name": "Oracle Capture",
  "version": "0.1.0",
  "description": "Capture the live page (clean Markdown + PDF) into your offline Oracle corpus, and 'Explain this' from the corpus in a glued popup.",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Oracle Capture"
  },
  "commands": {
    "capture-page": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Capture the current page to Oracle"
    }
  }
}
